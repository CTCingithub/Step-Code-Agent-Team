{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": [],
		"baseUrl": ".",
		"paths": {
			"@step-harness/coding-agent": ["sandbox/step/packages/coding-agent/dist/index.d.ts"],
			"@step-harness/providers": ["sandbox/step/packages/providers/dist/index.d.ts"],
			"@step-harness/pi-tui": ["sandbox/step/packages/tui/dist/index.d.ts"],
			"typebox": ["sandbox/step/packages/providers/node_modules/typebox"]
		}
	},
	"include": ["extensions/**/*.ts", "test/smoke/**/*.ts", "sandbox/smoke-phase*.ts"]
}
