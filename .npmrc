# The @step-harness/* core packages (and typebox) are provided by the step
# runtime through loader aliases — they are not published to a public
# registry, so peer resolution must not try to fetch them. This mirrors what
# step itself does for managed npm installs (--legacy-peer-deps) and keeps
# `npm install` working in a git clone, including step's git-install flow
# (clone -> checkout tag -> npm install --omit=dev).
legacy-peer-deps=true
