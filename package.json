  "description": "Agent team plugin for Step Code: leader session spawns resumable member agents, decomposes goals into dependency-aware tasks, and coordinates members via direct messaging.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "bin",
    "agents",
    "docs",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "bash test/run-smoke.sh"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@step-harness/coding-agent": "*",
    "@step-harness/providers": "*",
    "@step-harness/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@step-harness/coding-agent": { "optional": true },
    "@step-harness/providers": { "optional": true },
    "@step-harness/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
