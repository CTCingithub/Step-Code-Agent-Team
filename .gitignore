# Dependencies
node_modules/

# Dev sandbox: the reusable harness ships with the repo; runtime state does not.
# auth.json holds OAuth credentials (access/refresh tokens) — never commit it.
sandbox/agent/
sandbox/auth.json
sandbox/config.toml
sandbox/models-store.json
sandbox/*/sessions/
sandbox/*/teams/
sandbox/*/teams-*/
sandbox/*/live-context/
sandbox/project/data/

# Local agent state (session plans, local config)
.stepcode/

# Local credentials (test API keys — never commit)
local/

# Logs and OS files
*.log
.DS_Store
